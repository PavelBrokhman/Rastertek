#version 400
out vec4 outputColor;
void main(void) {
    float depthValue = gl_FragCoord.z;
    vec4 color;
    if (depthValue < 0.95f) color = vec4(1.0, 0.0f, 0.0f, 1.0f);
    if (depthValue > 0.95f) color = vec4(0.0, 1.0f, 0.0f, 1.0f);
    if (depthValue > 0.975f) color = vec4(0.0, 0.0f, 1.0f, 1.0f);
    outputColor = color;
}
