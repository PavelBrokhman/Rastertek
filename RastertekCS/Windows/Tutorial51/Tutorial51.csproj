    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Shaders\gbuffer.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\gbuffer.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\ssao.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\ssao.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\ssaoblur.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\ssaoblur.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\light.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\light.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\ice.tga" Link="Data\ice.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\metal001.tga" Link="Data\metal001.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\random_vec.tga" Link="Data\random_vec.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Models\sphere.txt" Link="Models\sphere.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Models\plane01.txt" Link="Models\plane01.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
