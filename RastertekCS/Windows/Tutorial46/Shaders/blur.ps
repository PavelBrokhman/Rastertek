cbuffer ScreenBuffer
{
    float screenWidth;
    float screenHeight;
    float blurType;
    float padding;
};

Texture2D shaderTexture : register(t0);
SamplerState SampleType : register(s0);

struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
};

float4 BlurPixelShader(PixelInputType input) : SV_TARGET
{
    float texelSize;
    float2 t1, t2, t3, t4, t5, t6, t7, t8, t9;

    if (blurType < 0.1f)
    {
        texelSize = 1.0f / screenWidth;
        t1 = input.tex + float2(texelSize * -4.0f, 0.0f);
        t2 = input.tex + float2(texelSize * -3.0f, 0.0f);
        t3 = input.tex + float2(texelSize * -2.0f, 0.0f);
        t4 = input.tex + float2(texelSize * -1.0f, 0.0f);
        t5 = input.tex + float2(0.0f, 0.0f);
        t6 = input.tex + float2(texelSize *  1.0f, 0.0f);
        t7 = input.tex + float2(texelSize *  2.0f, 0.0f);
        t8 = input.tex + float2(texelSize *  3.0f, 0.0f);
        t9 = input.tex + float2(texelSize *  4.0f, 0.0f);
    }
    else
    {
        texelSize = 1.0f / screenHeight;
        t1 = input.tex + float2(0.0f, texelSize * -4.0f);
        t2 = input.tex + float2(0.0f, texelSize * -3.0f);
        t3 = input.tex + float2(0.0f, texelSize * -2.0f);
        t4 = input.tex + float2(0.0f, texelSize * -1.0f);
        t5 = input.tex + float2(0.0f, 0.0f);
        t6 = input.tex + float2(0.0f, texelSize *  1.0f);
        t7 = input.tex + float2(0.0f, texelSize *  2.0f);
        t8 = input.tex + float2(0.0f, texelSize *  3.0f);
        t9 = input.tex + float2(0.0f, texelSize *  4.0f);
    }

    float w0 = 1.0f, w1 = 0.9f, w2 = 0.55f, w3 = 0.18f, w4 = 0.1f;
    float n = w0 + 2.0f * (w1 + w2 + w3 + w4);
    w0 /= n; w1 /= n; w2 /= n; w3 /= n; w4 /= n;

    float4 c = float4(0, 0, 0, 0);
    c += shaderTexture.Sample(SampleType, t1) * w4;
    c += shaderTexture.Sample(SampleType, t2) * w3;
    c += shaderTexture.Sample(SampleType, t3) * w2;
    c += shaderTexture.Sample(SampleType, t4) * w1;
    c += shaderTexture.Sample(SampleType, t5) * w0;
    c += shaderTexture.Sample(SampleType, t6) * w1;
    c += shaderTexture.Sample(SampleType, t7) * w2;
    c += shaderTexture.Sample(SampleType, t8) * w3;
    c += shaderTexture.Sample(SampleType, t9) * w4;
    c.a = 1.0f;
    return c;
}
