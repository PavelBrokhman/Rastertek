<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RastertekCS.Windows.Tutorial53</RootNamespace>
    <AssemblyName>Tutorial53</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Shaders\texture.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\texture.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\blur.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\blur.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\heat.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\heat.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\light.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\light.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\yellowcolor01.tga" Link="Data\yellowcolor01.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\heatnoise01.tga" Link="Data\heatnoise01.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Models\sphere.txt" Link="Models\sphere.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
