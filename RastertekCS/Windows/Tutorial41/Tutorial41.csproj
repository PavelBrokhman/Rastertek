<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RastertekCS.Windows.Tutorial41</RootNamespace>
    <AssemblyName>Tutorial41</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Shaders\depth.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\depth.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\shadow.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\shadow.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\wall01.tga" Link="Data\wall01.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\ice.tga" Link="Data\ice.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\metal001.tga" Link="Data\metal001.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Models\Cube.txt" Link="Models\Cube.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Models\sphere.txt" Link="Models\sphere.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Models\plane01.txt" Link="Models\plane01.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
