<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RastertekCS.Windows.Tutorial50</RootNamespace>
    <AssemblyName>Tutorial50</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Shaders\deferred.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\deferred.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\light.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\light.ps" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Data\stone01.tga" Link="Data\stone01.tga" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Assets\Models\cube.txt" Link="Models\cube.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
