<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RastertekCS.Windows.Tutorial40</RootNamespace>
    <AssemblyName>Tutorial40</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Shaders\projection.vs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Shaders\projection.ps" CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\Assets\Data\stone01.tga"
      Link="Data\stone01.tga"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\Assets\Data\metal001.tga"
      Link="Data\metal001.tga"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\Assets\Data\grate.tga"
      Link="Data\grate.tga"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\Assets\Models\Cube.txt"
      Link="Models\Cube.txt"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\Assets\Models\plane01.txt"
      Link="Models\plane01.txt"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
