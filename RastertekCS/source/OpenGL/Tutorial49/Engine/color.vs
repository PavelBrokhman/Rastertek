////////////////////////////////////////////////////////////////////////////////
// Filename: color.vs
////////////////////////////////////////////////////////////////////////////////
#version 400


/////////////////////
// INPUT VARIABLES //
/////////////////////
in vec3 inputPosition;
in vec3 inputColor;


//////////////////////
// OUTPUT VARIABLES //
//////////////////////
out vec3 hullPosition;
out vec3 hullColor;


////////////////////////////////////////////////////////////////////////////////
// Vertex Shader
////////////////////////////////////////////////////////////////////////////////
void main(void)
{
	// Pass the vertex position into the hull (tessellation control) shader.
	hullPosition = inputPosition;

	// Pass the vertex color into the hull (tessellation control) shader.
	hullColor = inputColor;
}
